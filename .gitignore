# Runtime state. .logs is disposable only while the daemon is stopped.
.logs/
obs/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/
.DS_Store

# Dart and Flutter residue, wherever the client lives. The mobile/ project
# carries the same rules; these catch a stray app or tool run outside it.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec_overrides.yaml
*.iml
.idea/

# Android build residue and the local SDK path. The Gradle wrapper stays
# ignored too: flutter injects it from the SDK template on the first build.
local.properties
key.properties
*.jks
*.keystore

# Credentials: never tracked, even by an explicit git add.
.env
.env.*
auth.json
credentials*
*.pem
*.key
*.p12
*.pfx
id_rsa*
